# =============
# 2. Data
# =============
# Ignore data directory contents by default
data/*
# Allow exchange subdirectories (idx, nasdaq, nse, tse, etc.) to be traversed
!data/*/
# Ignore all timeframe directories by default (intraday, weekly, etc.)
data/*/*

# IDX intraday data
data/idx/1T/
data/idx/3T/
data/idx/5T/
data/idx/15T/
data/idx/30T/
data/idx/1H/
data/idx/W/
data/idx/1T/**
data/idx/3T/**
data/idx/5T/**
data/idx/15T/**
data/idx/30T/**
data/idx/1H/**
data/idx/W/**

# Whitelist daily datasets
!data/*/D/
!data/*/D/**

# Binary & tabular data formats
*.csv
*.tsv
*.parquet
*.feather
*.arrow
*.npz
*.npy
*.pkl
*.pickle
*.h5
*.hdf5
*.mat

# Re-include daily dataset files across all exchanges
!data/*/D/*.csv
!data/*/D/*.npz
!data/*/D/*.parquet
!data/*/D/**

# Tickers & symbol lists
tickers.txt


# db
